#!/usr/bin/env bash
# Small control surface for the alert service, used by the bar widget and
# handy by hand. Keeps shell work (window focusing, curl) out of QML.

set -euo pipefail

TOKEN_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/claude-alerts/token"
PORT="${CLAUDE_ALERTS_PORT:-8787}"
BASE="http://127.0.0.1:$PORT"

token() { [[ -r $TOKEN_FILE ]] && tr -d '\n' < "$TOKEN_FILE" || echo ""; }
api() {
  local path="$1"; shift
  curl -fsS -m 5 -H "X-Alert-Token: $(token)" -H 'Content-Type: application/json' "$BASE$path" "$@"
}

# Focus the window belonging to a project.
#
# Both sides are slug-normalized before comparing, because the project name is
# a slug derived from the hook's cwd while the window title is prose. A VS Code
# devcontainer window reads:
#
#   Fix login bug - checkout (Workspace) [Dev Container: Checkout Service] - Visual Studio Code
#
# so a literal search for "checkout-service" finds nothing. Normalizing both to
# "checkout-service" matches. It has to be a containment test over the whole
# title: the leading segment is the active tab name and changes constantly, and
# only the "(Workspace) [Dev Container: …]" tail is stable.
focus_window() {
  local project="$1" addr
  command -v hyprctl >/dev/null 2>&1 || return 0
  addr=$(hyprctl -j clients 2>/dev/null | jq -r --arg p "$project" '
    def slug: ascii_downcase | gsub("[^a-z0-9]+";"-") | sub("^-";"") | sub("-$";"");
    map(select(.title != null and (.title | slug | contains($p | slug))))
    # focusHistoryID ascending = most recently focused first, the right window
    # to pick if a project name happens to appear in two titles.
    | sort_by(.focusHistoryID) | .[0].address // empty') || return 0
  [[ -n $addr ]] || return 1

  # Current Hyprland takes a Lua dispatch and rejects the old positional form
  # outright ("your syntax might need to be updated"); older builds only know
  # the positional one. Same two-step Omarchy's own omarchy-hyprland-focus-app
  # uses. Either way, report success on the focus, not on the fallback's status.
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1 ||
    hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1 ||
    return 1
  return 0
}

case "${1:-}" in
  focus)
    [[ -n ${2:-} ]] || { echo "usage: claude-alerts-ctl focus <project>" >&2; exit 2; }
    focus_window "$2" || echo "claude-alerts: no window matching '$2'" >&2
    # Acting on it is the same as attending to it.
    api /clear -X POST -d "{\"project\":$(jq -Rn --arg p "$2" '$p')}" >/dev/null || true
    ;;
  clear)
    if [[ -n ${2:-} ]]; then api /clear -X POST -d "{\"project\":$(jq -Rn --arg p "$2" '$p')}"
    else api /clear -X POST -d '{}'; fi
    ;;
  state)  api /state ;;
  health) curl -fsS -m 5 "$BASE/health" ;;
  test)   api /test -X POST -d '{}' ;;
  *)
    cat >&2 <<USAGE
usage: claude-alerts-ctl <command>
  focus <project>   focus that project's window and clear it from the list
  clear [project]   clear one project, or all
  state             what is currently waiting on you
  health            service liveness
  test              fire a test alert
USAGE
    exit 2 ;;
esac
